generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Order {
  id                 String     @id @default(cuid())
  orderNumber        String     @unique
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  paymentMethod      String
  items              String
  subtotal           Float
  shippingCost       Float
  total              Float
  promoCode          String?
  discount           Float?
  status             String     @default("pending")
  affiliateCode      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customerId         String?
  affiliate          Affiliate? @relation(fields: [affiliateCode], references: [code])
  customer           Customer?  @relation(fields: [customerId], references: [id])
}

model Customer {
  id               String               @id @default(cuid())
  email            String               @unique
  password         String
  name             String
  phone            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  address          String?
  city             String?
  postalCode       String?
  wishlist         String               @default("[]")
  orders           Order[]
  notes            CustomerNote[]
  tags             CustomerTag[]
  marketingConsent MarketingConsent?
  abandonedCarts   AbandonedCart[]
  campaigns        MarketingRecipient[]
}

model Product {
  id                  Int         @id @default(autoincrement())
  slug                String      @unique
  name                String
  brandId             String      @default("valentino")
  brandLabel          String
  gender              String
  subcategory         String
  subcategoryLabel    String
  tagline             String
  price               Float
  originalPrice       Float?
  description         String
  longDescription     String
  images              String
  notes               String
  ingredients         String
  sizes               String
  bottleColor         String
  bottleColorLabel    String
  bottleMaterial      String
  bottleMaterialLabel String
  rating              Float       @default(0)
  reviewCount         Int         @default(0)
  releaseDate         String
  tags                String
  inStock             Boolean     @default(true)
  stock               Int         @default(10)
  perfectSeason       String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  testerPrice         Float?
  isTester            Boolean     @default(false)
  sku                 String?     @unique
  published           Boolean     @default(true)
  brand               Brand       @relation(fields: [brandId], references: [slug])
  seo                 ProductSeo?
  reviews             Review[]
}

model Review {
  id          Int      @id @default(autoincrement())
  productSlug String
  author      String
  city        String
  rating      Int
  title       String
  comment     String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productSlug], references: [slug])
}

model SiteConfig {
  id                  Int      @id @default(autoincrement())
  adminUsername       String   @default("admin")
  adminPassword       String   @default("nouamane2024")
  shippingFee         Float    @default(35)
  contactPhone        String   @default("+212 5 35 63 42 18")
  contactEmail        String   @default("contact@nouamane.ma")
  heroTitle           String   @default("L'Essence de l'Élégance")
  heroSubtitle        String   @default("Découvrez notre collection de parfums de luxe, conçue pour laisser une empreinte inoubliable.")
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  whatsappUrl         String?
  updatedAt           DateTime @updatedAt
  featuredBestsellers String   @default("[]")
  featuredSeasonal    String   @default("[]")
  coffretsCoverImage  String   @default("/images/category/pack-decouverte-luxe.jpg")
  featuredLatest      String   @default("[]")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model LandingPage {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  subtitle     String
  heroImage    String
  deadline     DateTime?
  badgeText    String
  productSlugs String
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Visitor {
  id        String     @id @default(cuid())
  ipHash    String     @unique
  city      String?
  country   String?
  createdAt DateTime   @default(now())
  lastSeen  DateTime   @default(now())
  visits    PageView[]
}

model PageView {
  id        Int      @id @default(autoincrement())
  visitorId String
  pathname  String
  createdAt DateTime @default(now())
  device    String?
  referrer  String?
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  label       String
  description String
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String
  value     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  excerpt             String
  content             String
  coverImage          String
  author              String   @default("Nouamane")
  status              String   @default("draft")
  metaTitle           String?
  metaDescription     String?
  relatedProductSlugs String   @default("[]")
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  category            String   @default("Général")
  ctaLink             String?
  ctaText             String?
  tags                String   @default("[]")
}

model Affiliate {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  commissionRate   Float    @default(10)
  visits           Int      @default(0)
  sales            Int      @default(0)
  revenueGenerated Float    @default(0)
  commissionEarned Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model SeoSettings {
  id                           String   @id @default(cuid())
  siteName                     String   @default("NAY Parfum")
  siteUrl                      String   @default("https://nayparfum.ma")
  defaultTitle                 String?
  defaultDescription           String?
  defaultOgImage               String?
  defaultKeywords              String?
  robotsEnabled                Boolean  @default(true)
  sitemapUrl                   String?  @default("https://nayparfum.ma/sitemap.xml")
  googleSearchConsoleConnected Boolean  @default(false)
  googlePropertyUrl            String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  aiAutoApply                  Boolean  @default(false)
  aiModel                      String   @default("gemini-1.5-pro")
  aiProvider                   String   @default("GEMINI")
}

model GoogleSearchConsoleConnection {
  id                    String    @id @default(cuid())
  propertyUrl           String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  scopes                String
  connectedBy           String
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SeoSearchConsoleDaily {
  id          String   @id @default(cuid())
  date        DateTime
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  device      String
  country     String
  searchType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, device, country, searchType])
  @@index([date])
  @@index([device])
  @@index([country])
  @@index([searchType])
}

model SeoKeywordPerformance {
  id          String   @id @default(cuid())
  date        DateTime
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  country     String
  device      String
  searchType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([query])
  @@index([date])
  @@index([impressions])
  @@index([clicks])
  @@index([position])
}

model SeoPagePerformance {
  id          String   @id @default(cuid())
  date        DateTime
  url         String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  country     String
  device      String
  searchType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([url])
  @@index([date])
  @@index([impressions])
  @@index([clicks])
  @@index([position])
}

model SeoAudit {
  id                 String   @id @default(cuid())
  url                String   @unique
  statusCode         Int
  title              String?
  metaDescription    String?
  canonicalUrl       String?
  robots             String?
  h1Count            Int      @default(0)
  h2Count            Int      @default(0)
  wordCount          Int      @default(0)
  imageCount         Int      @default(0)
  imagesWithoutAlt   Int      @default(0)
  internalLinks      Int      @default(0)
  externalLinks      Int      @default(0)
  hasSchema          Boolean  @default(false)
  schemaTypes        String?
  hasOpenGraph       Boolean  @default(false)
  hasTwitterCard     Boolean  @default(false)
  isIndexable        Boolean  @default(true)
  isMobileFriendly   Boolean  @default(true)
  performanceScore   Int      @default(0)
  seoScore           Int      @default(0)
  accessibilityScore Int      @default(0)
  lastCheckedAt      DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SeoIssue {
  id              String    @id @default(cuid())
  url             String
  type            String
  severity        String
  title           String
  description     String?
  recommendation  String?
  status          String    @default("OPEN")
  metadata        String?
  firstDetectedAt DateTime  @default(now())
  lastDetectedAt  DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([url])
  @@index([severity])
  @@index([status])
}

model SeoOpportunity {
  id             String   @id @default(cuid())
  type           String   @default("KEYWORD")
  keyword        String?
  title          String?
  description    String?
  impressions    Int?
  clicks         Int?
  ctr            Float?
  recommendation String?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  businessValue  Int      @default(50)
  country        String   @default("MA")
  effort         String   @default("MEDIUM")
  impact         String   @default("MEDIUM")
  position       Float?
  targetUrl      String?
  priority       Int      @default(0)

  @@index([type])
  @@index([status])
  @@index([priority])
}

model ProductSeo {
  id                String    @id @default(cuid())
  productId         Int       @unique
  seoTitle          String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  schemaEnabled     Boolean   @default(true)
  seoScore          Int       @default(0)
  aiGenerated       Boolean   @default(false)
  lastOptimizedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CategorySeo {
  id                String   @id @default(cuid())
  categoryId        String   @unique
  seoTitle          String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  seoScore          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SeoAiGeneration {
  id                   String   @id @default(cuid())
  entityType           String
  entityId             String
  inputData            String
  generatedTitle       String?
  generatedDescription String?
  generatedContent     String?
  generatedKeywords    String?
  generatedFaq         String?
  generatedSchema      String?
  model                String
  status               String   @default("GENERATED")
  createdBy            String
  createdAt            DateTime @default(now())
}

model SeoSyncJob {
  id               String    @id @default(cuid())
  type             String
  status           String    @default("PENDING")
  startedAt        DateTime?
  completedAt      DateTime?
  recordsProcessed Int       @default(0)
  errorMessage     String?
  metadata         String?
  createdBy        String
  createdAt        DateTime  @default(now())
}

model SeoSitemapStatus {
  id             String    @id @default(cuid())
  sitemapUrl     String    @unique
  httpStatus     Int?
  isValid        Boolean   @default(false)
  urlCount       Int       @default(0)
  lastCheckedAt  DateTime?
  lastModifiedAt DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SeoKeyword {
  id               String   @id @default(cuid())
  keyword          String   @unique
  language         String   @default("FR")
  country          String   @default("MA")
  searchIntent     String   @default("TRANSACTIONAL")
  searchVolume     Int      @default(0)
  competition      Float    @default(0)
  difficulty       Int      @default(0)
  currentPosition  Float?
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float    @default(0)
  url              String?
  opportunityScore Int      @default(0)
  businessValue    String   @default("MEDIUM")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([language])
  @@index([country])
  @@index([searchIntent])
  @@index([opportunityScore])
}

model SeoTopic {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  parentTopic String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoTopicKeyword {
  id        String   @id @default(cuid())
  topicId   String
  keyword   String
  createdAt DateTime @default(now())

  @@unique([topicId, keyword])
}

model SeoTopicPage {
  id        String   @id @default(cuid())
  topicId   String
  url       String
  createdAt DateTime @default(now())

  @@unique([topicId, url])
}

model SeoContentUpdate {
  id             String   @id @default(cuid())
  url            String
  reason         String
  recommendation String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SeoInternalLink {
  id              String   @id @default(cuid())
  sourceUrl       String
  targetUrl       String
  anchorText      String
  relevanceScore  Int      @default(0)
  topicSimilarity Int      @default(0)
  intentMatch     Boolean  @default(false)
  businessValue   String   @default("MEDIUM")
  status          String   @default("SUGGESTED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SeoReferringDomain {
  id             String   @id @default(cuid())
  domain         String   @unique
  authorityScore Int      @default(0)
  spamScore      Int      @default(0)
  isMoroccan     Boolean  @default(false)
  category       String?
  status         String   @default("OPPORTUNITY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SeoBacklink {
  id           String   @id @default(cuid())
  sourceDomain String
  sourceUrl    String
  targetUrl    String
  anchorText   String?
  isFollow     Boolean  @default(true)
  status       String   @default("ACTIVE")
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceUrl, targetUrl])
}

model SeoGoal {
  id           String   @id @default(cuid())
  name         String
  targetValue  Float
  currentValue Float    @default(0)
  metric       String
  period       String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeoAuditLog {
  id        String   @id @default(cuid())
  action    String
  entityId  String?
  details   String?
  createdBy String   @default("SYSTEM")
  createdAt DateTime @default(now())
}

model SeoAnalyticsDaily {
  id              String   @id
  date            DateTime @unique
  organicUsers    Int      @default(0)
  organicSessions Int      @default(0)
  productViews    Int      @default(0)
  addToCart       Int      @default(0)
  checkouts       Int      @default(0)
  orders          Int      @default(0)
  revenue         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model SeoConversionEvent {
  id            String   @id
  eventType     String
  url           String
  transactionId String?  @unique
  revenue       Float?
  currency      String?  @default("MAD")
  sessionId     String?
  createdAt     DateTime @default(now())
}

model SeoLandingPagePerformance {
  id              String   @id
  url             String   @unique
  date            DateTime @default(now())
  organicSessions Int      @default(0)
  productViews    Int      @default(0)
  addToCart       Int      @default(0)
  orders          Int      @default(0)
  revenue         Float    @default(0)
  conversionRate  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model SeoExperiment {
  id                String   @id @default(cuid())
  name              String
  url               String
  keyword           String?
  startDate         DateTime
  baselinePeriod    Int      @default(28)
  measurementPeriod Int      @default(28)
  status            String   @default("PLANNED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==========================================
// CRM MODELS
// ==========================================

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  note       String
  createdBy  String   @default("SYSTEM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  tag        String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
}

// ==========================================
// MARKETING & RETENTION MODELS
// ==========================================

model MarketingConsent {
  id                       String   @id @default(cuid())
  customerId               String   @unique
  emailMarketingConsent    Boolean  @default(false)
  whatsappMarketingConsent Boolean  @default(false)
  consentSource            String   @default("UNKNOWN")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model AbandonedCart {
  id           String   @id @default(cuid())
  customerId   String
  cartItems    String // JSON stringified array of products
  cartValue    Float
  status       String   @default("ACTIVE") // ACTIVE, ABANDONED, RECOVERED, EXPIRED
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model MarketingCampaign {
  id          String               @id @default(cuid())
  name        String
  channel     String // EMAIL, WHATSAPP
  type        String // WELCOME, ABANDONED_CART, POST_PURCHASE, REACTIVATION, VIP, PROMOTION
  audience    String // JSON representing segmentation criteria
  subject     String?
  message     String
  status      String               @default("DRAFT") // DRAFT, REVIEW, APPROVED, SCHEDULED, SENT, CANCELLED
  scheduledAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  recipients  MarketingRecipient[]
}

model MarketingRecipient {
  id         String            @id @default(cuid())
  campaignId String
  customerId String
  status     String            @default("PENDING") // PENDING, SENT, FAILED, DELIVERED, OPENED, CLICKED
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
}

model MarketingSettings {
  id                 String   @id @default(cuid())
  emailConfigured    Boolean  @default(false)
  whatsappConfigured Boolean  @default(false)
  automationEnabled  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// AI VISIBILITY MODELS (PHASE 14)
// ==========================================

model SeoAiQuery {
  id           String   @id @default(cuid())
  prompt       String
  language     String   @default("FR")
  country      String   @default("MA")
  category     String?
  targetEntity String   @default("NAY Parfum")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeoAiMention {
  id          String   @id @default(cuid())
  platform    String
  prompt      String
  brand       String   @default("NAY Parfum")
  mentioned   Boolean  @default(false)
  cited       Boolean  @default(false)
  citationUrl String?
  targetUrl   String?
  position    Int?
  checkedAt   DateTime @default(now())
  sourceType  String   @default("MANUAL")
  status      String   @default("UNKNOWN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoAiVisibilityAudit {
  id                     String   @id @default(cuid())
  aiVisibilityScore      Int      @default(0)
  entityStrength         Int      @default(0)
  citationReadiness      Int      @default(0)
  contentCoverage        Int      @default(0)
  productCoverage        Int      @default(0)
  questionCoverage       Int      @default(0)
  moroccoCoverage        Int      @default(0)
  technicalAccessibility Int      @default(0)
  status                 String   @default("PASS")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
